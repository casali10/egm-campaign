# egm-campaign: campaign prep protocol
#
# Blue    = Elephant-led work
# Orange  = Goldfish review
# Violet  = Iteration and the loop to the next session
# Neutral = The GM's decisions and play at the table
#
# Animated arrows are reserved for Goldfish handoffs.
# Self-loops on GOLDFISH list lenses and reviewers, not an order.
# Render with: node docs/assets/render.mjs

vars: {
  d2-config: {
    theme-id: 0
    dark-theme-id: 200
    pad: 55
  }
}

style.fill: transparent

classes: {
  participant: {
    width: 185
    height: 70
    style: {
      border-radius: 12
      stroke-width: 3
      font-size: 19
      bold: true
    }
  }
  # GOLDFISH carries notes, so it cannot also carry width and height.
  participant-note: {
    style: {
      border-radius: 12
      stroke-width: 3
      font-size: 19
      bold: true
    }
  }
  blue: {style.stroke: "#2B7BC1"}
  orange: {style.stroke: "#EF902E"}
  neutral: {style.stroke: "#8292A6"}

  frame: {
    style: {
      border-radius: 12
      stroke-width: 2
      font-size: 22
      bold: true
    }
  }
  frame-blue: {
    style: {
      stroke: "#2B7BC1"
      fill: "linear-gradient(rgba(43,123,193,0.07),rgba(43,123,193,0.07))"
    }
  }
  frame-orange: {
    style: {
      stroke: "#EF902E"
      fill: "linear-gradient(rgba(239,144,46,0.07),rgba(239,144,46,0.07))"
    }
  }
  frame-neutral: {
    style: {
      stroke: "#8292A6"
      fill: "linear-gradient(rgba(130,146,166,0.06),rgba(130,146,166,0.06))"
    }
  }
  loop: {
    style: {
      stroke: "#A78BFA"
      stroke-width: 3
      stroke-dash: 5
      fill: "linear-gradient(rgba(167,139,250,0.13),rgba(167,139,250,0.13))"
      border-radius: 10
      font-size: 17
      bold: true
    }
  }
  review-note: {
    style: {
      stroke: "#8292A6"
      stroke-width: 2
      stroke-dash: 4
      font-size: 16
    }
  }
  invisible: {
    label: ""
    style: {
      fill: transparent
      stroke-width: 0
      opacity: 0
    }
  }

  design-line: {
    style: {
      stroke: "#2B7BC1"
      stroke-width: 3
      font-size: 17
    }
  }
  review-line: {
    style: {
      stroke: "#EF902E"
      stroke-width: 3
      font-size: 17
    }
  }
  human-line: {
    style: {
      stroke-width: 3
      font-size: 17
    }
  }
  next-line: {
    style: {
      stroke: "#A78BFA"
      stroke-width: 3
      stroke-dash: 5
      font-size: 17
    }
  }
  handoff: {
    style: {
      stroke: "#EF902E"
      stroke-width: 4
      font-size: 18
      bold: true
      animated: true
    }
  }
}

shape: sequence_diagram

# ==========================================
# PARTICIPANTS
# ==========================================

H: "YOU\nGame master" {class: [participant; neutral]}
E: "ELEPHANT\nDeep context" {class: [participant; blue]}
D: "CAMPAIGN DOC\nSource of truth" {class: [participant; neutral]}
G: "GOLDFISH\nFresh context" {class: [participant-note; orange]}
T: "THE TABLE\nPlayers and play" {class: [participant; neutral]}

# Every phase frame carries the same hidden H-to-T message so the frames
# span all five participants.

# ==========================================
# PHASE 1 — BRAINSTORM
# ==========================================

phase1: " PHASE 1  /  Brainstorm the pitch" {
  class: [frame; frame-blue]
  aligner: {
    class: invisible
    H -> T: "" {style.opacity: 0}
  }

  H -> E: "/campaign-brainstorm <pitch>" {class: design-line}
  E -> H: "Ask about the table and the eight steps" {class: design-line}
  H -> E: "Players, tone, difficulty, boundaries" {class: human-line}
  E -> G: "Spawn seven independent lenses" {class: handoff}

  G."Seven lenses run concurrently": {class: review-note}

  G -> G: "Character hooks" {class: review-line}
  G -> G: "Strong start & table fit" {class: review-line}
  G -> G: "Scene agency" {class: review-line}
  G -> G: "Secrets & clues" {class: review-line}
  G -> G: "Improvisation kit" {class: review-line}
  G -> G: "Challenge & stakes" {class: review-line}
  G -> G: "Prep economy" {class: review-line}

  G -> E: "Blockers, Majors, Nits" {class: handoff}
  E -> H: "Lead with what is weak" {class: design-line}
  H -> E: "Accept, change, or reject" {class: human-line}
  E -> D: "Save prep_brief.md" {class: design-line}
}

# ==========================================
# PHASE 2 — DRAFT
# ==========================================

phase2: " PHASE 2  /  Draft the campaign" {
  class: [frame; frame-blue]
  aligner: {
    class: invisible
    H -> T: "" {style.opacity: 0}
  }

  H -> E: "/campaign-draft" {class: design-line}
  E -> D: "Read the brief" {class: design-line}

  sections: " ITERATE  /  Premise, arc, contingencies, session prep" {
    class: loop
    E -> D: "Draft one section" {class: design-line}
    E -> H: "Present it" {class: design-line}
    H -> E: "Approve or revise" {class: human-line}
  }

  E -> D: "Save campaigns/<name>.md" {class: design-line}
}

# ==========================================
# PHASE 3 — REVIEW
# ==========================================

phase3: " PHASE 3  /  Review with fresh eyes" {
  class: [frame; frame-orange]
  aligner: {
    class: invisible
    H -> T: "" {style.opacity: 0}
  }

  H -> E: "/campaign-review <file> arc | session <n>" {class: design-line}
  E -> G: "Spawn reviewers on the document only" {class: handoff}

  G."Arc pass": {class: review-note}
  G -> G: "Continuity" {class: review-line}
  G -> G: "Table critic" {class: review-line}

  G."Session pass": {class: review-note}
  G -> G: "Substitute GM" {class: review-line}
  G -> G: "Player's eye" {class: review-line}
  G -> G: "Difficulty" {class: review-line}

  G -> E: "Findings against the run-readiness standard" {class: handoff}
  E -> D: "Write campaign_review_report.md" {class: design-line}

  decide: " ITERATE  /  Blockers and Majors" {
    class: loop
    E -> H: "Propose a short fix" {class: design-line}
    H -> E: "Accept, change, or reject" {class: human-line}
    E -> D: "Edit the document" {class: design-line}
  }

  again: " OPTIONAL  /  Review again with new Goldfish (two rounds by default)" {
    class: loop
    E -> G: "Fresh reviewers, same pass" {class: handoff}
    G -> E: "New findings" {class: review-line}
  }
}

# ==========================================
# PHASE 4 — PLAY
# ==========================================

phase4: " PHASE 4  /  Play the session" {
  class: [frame; frame-neutral]
  aligner: {
    class: invisible
    H -> T: "" {style.opacity: 0}
  }

  H -> D: "Run from the session prep" {class: human-line}
  H -> T: "Strong start" {class: human-line}
  T -> H: "Choices the prep did not expect" {class: human-line}
}

# ==========================================
# PHASE 5 — DEBRIEF
# ==========================================

phase5: " PHASE 5  /  Debrief and carry forward" {
  class: [frame; frame-blue]
  aligner: {
    class: invisible
    H -> T: "" {style.opacity: 0}
  }

  H -> E: "/campaign-brainstorm after session <n>" {class: design-line}
  E -> D: "Read the planned secrets, hooks, and scenes" {class: design-line}
  E -> H: "Ask what happened, a few questions at a time" {class: design-line}
  H -> E: "What surfaced, what changed" {class: human-line}
  E -> D: "Update After play, secret status, open threads" {class: design-line}
  E -> H: "Suggest the next strong start" {class: design-line}
  H -> E: "/campaign-draft session <n+1>" {class: next-line}
  E -> H: "Changed the arc? Run /campaign-review arc" {class: next-line}
}
